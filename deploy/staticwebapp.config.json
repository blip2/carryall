{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin"
  },
  "routes": [
    {
      "route": "/*.version.json",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/*.html",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "mimeTypes": {
    ".json": "application/json"
  }
}
